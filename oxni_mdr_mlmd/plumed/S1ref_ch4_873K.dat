# generated by make_plumed.py from S1_ref_ni211_bare_gas.extxyz (mode ch4)
UNITS LENGTH=A ENERGY=eV TIME=fs
# temperature 873 K
# gas reference volume V_ref ~ 511 A^3: events per site per s = k(V_ref) * p*V_ref/kT / N_exposed_Ni
cn: COORDINATION GROUPA=713 GROUPB=714,715,716,717 SWITCH={RATIONAL R_0=1.60 NN=8 MM=16}
lw: LOWER_WALLS ARG=cn AT=2.5 KAPPA=20.0   # stop at CH3*+H* (first C-H cleavage)
ctr: FIXEDATOM AT=12.207,13.705,10.071
d: DISTANCE ATOMS=ctr,713 COMPONENTS
rxy: CUSTOM ARG=d.x,d.y FUNC=sqrt(x*x+y*y) PERIODIC=NO
uwz: UPPER_WALLS ARG=d.z AT=6.50 KAPPA=5.0
uwr: UPPER_WALLS ARG=rxy AT=5.00 KAPPA=5.0
opes: OPES_METAD ARG=cn PACE=500 BARRIER=1.50 TEMP=873 FILE=KERNELS STATE_WFILE=STATE STATE_WSTRIDE=10000
PRINT ARG=cn,d.z,rxy,opes.bias,uwz.bias,uwr.bias,lw.bias STRIDE=50 FILE=COLVAR
