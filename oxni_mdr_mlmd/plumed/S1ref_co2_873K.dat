# generated by make_plumed.py (mode co2); run the MD from S1ref_co2_873K_start.extxyz
UNITS LENGTH=A ENERGY=eV TIME=fs
# temperature 873 K
# reference cylinder on the pore axis: radius 5.0 A, 0-8.0 A above the exposed Ni; geometric volume 628 A^3
# per-site rate at pressure p = k * p*V_eff/kT / N_exposed_Ni, V_eff = integral of exp(-w(z)/kT) over the cylinder (reweighted d.z histogram)
cn: COORDINATION GROUPA=661 GROUPB=662,663 SWITCH={RATIONAL R_0=1.85 NN=8 MM=16}
lw: LOWER_WALLS ARG=cn AT=0.6 KAPPA=20.0   # stop at CO*+O*
ctr: FIXEDATOM AT=12.207,13.705,10.071
d: DISTANCE ATOMS=ctr,661 COMPONENTS
rxy: CUSTOM ARG=d.x,d.y FUNC=sqrt(x*x+y*y) PERIODIC=NO
uwz: UPPER_WALLS ARG=d.z AT=8.00 KAPPA=5.0
uwr: UPPER_WALLS ARG=rxy AT=5.00 KAPPA=5.0
opes: OPES_METAD ARG=cn PACE=500 BARRIER=1.50 TEMP=873 FILE=KERNELS STATE_WFILE=STATE STATE_WSTRIDE=10000
PRINT ARG=cn,d.z,rxy,opes.bias,uwz.bias,uwr.bias,lw.bias STRIDE=50 FILE=COLVAR
